# ===========================================
# Messenger v2 — Environment Example
# Copy to .env and fill secrets: cp .env.example .env
# See .env (dev defaults) and .env.prod (prod template)
# ===========================================

# --- Project (frozen) ---
# Do not change without maintainer command — used as server image tag
PROJECT_VERSION=

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- Cassandra ---
CASSANDRA_CLUSTER_NAME=
CASSANDRA_KEYSPACE=
CASSANDRA_PORT=
CASSANDRA_DC=

# --- Rust Server (gRPC) ---
GRPC_PORT=
SERVER_HOST=
SERVER_PORT=
RUST_LOG=
# For local dev keep templated URL; for prod fill concrete host
DATABASE_URL=
CASSANDRA_URL=

# --- RustFS (S3-compatible attachment storage) ---
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_S3_PORT=
RUSTFS_CONSOLE_PORT=
RUSTFS_BUCKET=
RUSTFS_ENDPOINT=
RUSTFS_PUBLIC_ENDPOINT=

# --- Flutter Client ---
FLUTTER_DEBUG_PORT=

# --- Secrets ---
JWT_SECRET=
